---
import { asset, brand, nav, stapled } from "../data/site";
---
<footer class="ftr">
  <div class="wrap ftr__cols">
    <div>
      <p class="label soft">Contact</p>
      <ul>
        <li><a href={brand.phoneHref} data-contact="phone">{brand.phone}</a></li>
        <li><a href={brand.whatsappHref} data-contact="whatsapp">WhatsApp {brand.whatsapp}</a></li>
        <li><a href={`mailto:${brand.email}`} data-contact="email">{brand.email}</a></li>
        <li class="soft">{brand.hours}</li>
      </ul>
    </div>
    <div>
      <p class="label soft">Site</p>
      <ul>
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        <li><a href="#quote">Get a quote</a></li>
      </ul>
    </div>
    <div>
      <p class="label soft">Area</p>
      <ul>
        <li>{brand.area}</li>
        <li class="soft">{brand.yard}</li>
      </ul>
    </div>
    <div class="ftr__concept">
      <p class="label soft">About this site</p>
      <p>{brand.fullName} is a fictional company. This is a website design concept by <a href={stapled.url}>Stapled.</a> Projects and photographs are illustrative.</p>
      <p><a href={asset("/concept/")}>Concept notes and image credits</a></p>
    </div>
  </div>

  <div class="ftr__word" aria-hidden="true" data-footer-word>
    <span class="ftr__bar" data-footer-bar></span>
    <span class="ftr__text">Transom</span>
  </div>

  <div class="wrap ftr__base label">
    <span>© Stapled. concept, {new Date().getFullYear()}</span>
    <a href="#top">Back to top ↑</a>
  </div>
</footer>

<style>
  .ftr { background: var(--ink); color: var(--on-ink); padding-top: clamp(4rem, 8vw, 7rem); overflow: hidden; }
  .ftr__cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr)) minmax(0, 1.4fr);
    gap: 2.5rem 2rem;
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .ftr__cols .label { margin-bottom: 1rem; }
  .ftr__cols ul { display: grid; gap: 0.15rem; }
  .ftr__cols a { display: inline-flex; min-height: 2.25rem; align-items: center; text-decoration: none; }
  .ftr__cols a:hover { text-decoration: underline; text-decoration-color: var(--signal); text-underline-offset: 0.2em; }
  .ftr__cols li.soft { padding-block: 0.4rem; }
  .ftr__concept { display: grid; gap: 0.75rem; align-content: start; color: var(--on-ink-soft); }
  .ftr__concept a { color: var(--on-ink); text-decoration: underline; text-underline-offset: 0.2em; min-height: 0; display: inline; }

  .ftr__word {
    position: relative;
    font-family: var(--display);
    font-weight: 900;
    font-size: 26.4vw;
    line-height: 0.74;
    text-transform: uppercase;
    text-align: center;
    letter-spacing: -0.01em;
    color: var(--ink-3);
    margin-bottom: -0.04em;
    user-select: none;
  }
  .ftr__text { position: relative; display: block; }
  .ftr__bar {
    position: absolute;
    left: 0;
    right: 0;
    top: 36%;
    height: max(6px, 1.1vw);
    background: var(--signal);
    transform-origin: left;
    z-index: 1;
    mix-blend-mode: normal;
  }
  :global(html.js-motion) .ftr__bar { transform: scaleX(0); }
  .ftr__base {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--rule-ink);
    color: var(--on-ink-soft);
    position: relative;
    background: var(--ink);
  }
  .ftr__base a { text-decoration: none; }
  .ftr__base a:hover { color: var(--on-ink); }

  @media (max-width: 900px) {
    .ftr__cols { grid-template-columns: 1fr 1fr; }
    .ftr__concept { grid-column: 1 / -1; }
  }
</style>
